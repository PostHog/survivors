{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["prospect", "title", "tagline", "palette", "products", "music", "text", "game"],
  "additionalProperties": false,
  "properties": {
    "prospect": {
      "type": "object",
      "required": ["name", "short"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 40, "description": "Company name as they write it" },
        "short": { "type": "string", "minLength": 1, "maxLength": 14, "description": "Short name for tight spots" },
        "domain": { "type": "string", "maxLength": 60 }
      }
    },
    "title": { "type": "string", "minLength": 3, "maxLength": 30, "description": "Game title shown big on the title screen" },
    "tagline": { "type": "string", "minLength": 3, "maxLength": 48, "description": "One line under the title, e.g. 'Made for Acme Rockets by PostHog'" },
    "palette": {
      "type": "object",
      "required": ["primary", "secondary", "accent"],
      "additionalProperties": false,
      "properties": {
        "primary": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "description": "Main brand colour" },
        "secondary": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "description": "Second brand colour; the darker one becomes the background" },
        "accent": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "description": "Highlight colour for selections and titles" }
      }
    },
    "products": {
      "type": "array", "minItems": 3, "maxItems": 6, "uniqueItems": true,
      "items": { "type": "string", "enum": [] },
      "description": "PostHog products featured in the game, most relevant first"
    },
    "music": {
      "type": "object",
      "required": ["mood"],
      "additionalProperties": false,
      "properties": {
        "mood": { "type": "string", "minLength": 3, "maxLength": 80, "description": "Mood words for the chiptune generator" },
        "bpm": { "type": "integer", "minimum": 80, "maximum": 180 }
      }
    },
    "text": {
      "type": "object",
      "required": ["win", "lose", "credits"],
      "additionalProperties": false,
      "properties": {
        "win": { "type": "string", "minLength": 3, "maxLength": 110 },
        "lose": { "type": "string", "minLength": 3, "maxLength": 110 },
        "credits": { "type": "string", "minLength": 3, "maxLength": 80 }
      }
    },
    "game": { "type": "object" }
  }
}
