{
  "name": "survivors",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "game",
    "admin"
  ],
  "scripts": {
    "dev": "wrangler dev --local-upstream localhost:8787 --upstream-protocol http",
    "dev:game": "npm run dev -w game",
    "build": "npm run build -w game && npm run build -w admin && node scripts/assemble.mjs",
    "art": "npm run art -w game",
    "guide": "npm run guide -w game",
    "deploy": "npm run build && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply survivors --local",
    "check": "biome check . && npm run typecheck",
    "fix": "biome check --write .",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p test && npm run typecheck -w game && npm run typecheck -w admin",
    "test": "vitest run",
    "pretest": "npm run build",
    "e2e": "node scripts/e2e.mjs",
    "dev:admin": "npm run dev -w admin"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.84",
    "@ai-sdk/openai": "^4.0.98",
    "@cfworker/json-schema": "^4.1.1",
    "@hono/zod-validator": "^0.9.1",
    "ai": "^7.0.147",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@cloudflare/vitest-plugin": "^1.4.6",
    "@cloudflare/workers-types": "^5.20260930.2",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  }
}
